{
  "_about": "One rule list for every board. When a card is added or moves, the first rule that matches decides the channel (a key in channels.json), the bot name and emoji, who is tagged (the first one filled in: assignee, reviewer, owner, or client.<role column>) and the one thing they must do. 'thread' puts that column of the card in a thread reply. No rule, no post. A stage name here must be spelled exactly as in the database.",
  "boards": {
    "tasks": {
      "label": "Tasks",
      "final": [
        "100 - Complete",
        "-1 - Rejected"
      ]
    },
    "videos": {
      "label": "Editing pipeline",
      "final": [
        "100 - Posted"
      ]
    }
  },
  "client_roles": [
    "account_manager_id",
    "editor_id",
    "social_media_manager_id"
  ],
  "rules": [
    {
      "board": "*",
      "when": "new",
      "channel": "new-tasks",
      "bot_name": "New Card",
      "emoji": "🆕",
      "tag": [
        "assignee",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the card, then give it a person and a due date if it has none."
    },
    {
      "board": "tasks",
      "to": [
        "9 - Blocked"
      ],
      "channel": "task-updates",
      "bot_name": "Task Blocked",
      "emoji": "🧱",
      "tag": [
        "client.account_manager_id",
        "owner"
      ],
      "action": "Help unblock this task. The notes on the card say what is in the way.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "-1 - Rejected"
      ],
      "channel": "task-updates",
      "bot_name": "Task Rejected",
      "emoji": "🚫",
      "tag": [
        "assignee"
      ],
      "action": "This task will not be done. Stop work on it.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "29 - Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Needs Amendments",
      "emoji": "✏️",
      "tag": [
        "assignee"
      ],
      "action": "Make the changes, then move the card back to review.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "30 - In Review"
      ],
      "channel": "review",
      "bot_name": "Ready For Review",
      "emoji": "👀",
      "tag": [
        "reviewer",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the work, then move it to Complete or send it back."
    },
    {
      "board": "tasks",
      "to": [
        "100 - Complete"
      ],
      "channel": "approved",
      "bot_name": "Task Complete",
      "emoji": "🙌",
      "tag": [
        "assignee"
      ],
      "action": "Nothing more to do. Well done."
    },
    {
      "board": "videos",
      "to": [
        "10 - Ready To Edit"
      ],
      "channel": "task-updates",
      "bot_name": "New Video For Editing",
      "emoji": "🎨",
      "tag": [
        "assignee",
        "client.editor_id"
      ],
      "action": "Edit the video, then move it to Internal Review."
    },
    {
      "board": "videos",
      "to": [
        "30 - Internal Review"
      ],
      "channel": "review",
      "bot_name": "New Content For Review",
      "emoji": "👀",
      "tag": [
        "reviewer",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the video, then send it to the client or back to the editor."
    },
    {
      "board": "videos",
      "to": [
        "39 - Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Needs Amendments",
      "emoji": "📷",
      "tag": [
        "assignee",
        "client.editor_id"
      ],
      "action": "Make the changes, then move it back to Internal Review.",
      "thread": "feedback_notes"
    },
    {
      "board": "videos",
      "to": [
        "40 - Client Review"
      ],
      "channel": "review",
      "bot_name": "Sent For Client Review",
      "emoji": "📤",
      "tag": [
        "client.account_manager_id",
        "owner"
      ],
      "action": "Send it to the client, then move the card when they answer."
    },
    {
      "board": "videos",
      "to": [
        "49 - Client Changes"
      ],
      "channel": "amendments",
      "bot_name": "Client Changes",
      "emoji": "🔁",
      "tag": [
        "assignee",
        "client.editor_id"
      ],
      "action": "Make the client's changes, then move it back to Internal Review.",
      "thread": "feedback_notes"
    },
    {
      "board": "videos",
      "to": [
        "50 - Ready To Post"
      ],
      "channel": "task-updates",
      "bot_name": "Ready To Post",
      "emoji": "📲",
      "tag": [
        "client.social_media_manager_id",
        "client.account_manager_id"
      ],
      "action": "Write the caption if needed, then schedule the post."
    },
    {
      "board": "videos",
      "to": [
        "100 - Posted"
      ],
      "channel": "approved",
      "bot_name": "Posted",
      "emoji": "🙌",
      "tag": [
        "client.account_manager_id",
        "client.social_media_manager_id"
      ],
      "action": "Nothing more to do. It is live."
    }
  ]
}
